# ------------------------------------------------------------------
# Supabase connection — copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
#
# In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to the
# app bundle. The anon key is designed to be shipped to clients — it is
# safe to expose because Row-Level Security (not this key) is the real
# security boundary. NEVER put the Supabase service_role key in here or
# anywhere in the app; it bypasses RLS.
# ------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
