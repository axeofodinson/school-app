          { "key": "D", "text": { "en": "8", "ur": "8" } }
        ]
      },
      "answer": { "correct": "B" },
      "explanation": { "en": "$2x + 4 = 3x$ gives $x = 4$.", "ur": "$2x + 4 = 3x$ سے $x = 4$۔" }
