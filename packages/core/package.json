{
  "name": "@school/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript logic shared by the app: no React, unit-tested in Node.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db-types": "./src/db-types.ts",
    "./design": "./src/design/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.0.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
