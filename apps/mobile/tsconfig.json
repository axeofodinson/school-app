{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    // The old app at the repo root pins React 18 / RN 0.74 / Reanimated 3, and
    // packages hoisted to the root (e.g. moti) would type-check against those.
    // Pin the shared singletons to this app's copies (metro.config.js does the
    // same at runtime). Remove once the old app leaves the root.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "react-native-reanimated": [
        "./node_modules/react-native-reanimated/lib/typescript/index.d.ts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
