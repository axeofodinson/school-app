# Copy to .env (gitignored). Only EXPO_PUBLIC_* vars reach the bundle; the anon
# key is public by design (RLS is the boundary). Never put the service-role key here.
# Point these at the DEV Supabase project for development (DECISIONS #27).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
